{
  "name": "bluebox-one-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bridge": "tsx bridge/src/index.ts",
    "bridge:mock": "tsx bridge/src/index.ts",
    "bridge:real": "set \"BLUEBOX_BRIDGE_MODE=real\" && set \"MOCK_PHYSICAL_BLUEBOX=false\" && tsx bridge/src/index.ts",
    "ble:scan": "powershell -NoProfile -ExecutionPolicy Bypass -File bridge/windows-ble/run-ble-helper.ps1 scan",
    "ble:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File bridge/windows-ble/run-ble-helper.ps1 connect",
    "bridge:mock-android": "tsx bridge/src/mock-android.ts",
    "bridge:mock-tamper": "tsx bridge/src/mock-physical-tamper.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
